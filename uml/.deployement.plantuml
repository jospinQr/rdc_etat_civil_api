@startuml
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 13

' ── Clients ──────────────────────────────────────────

node "Poste Agent\n(Windows)" as Desktop {
    component "App Desktop (Kotlin Compose)" as DesktopApp
}

node "Tablette / Mobile\n(Android)" as Mobile {
    component "App Mobile\n(Android)" as MobileApp
}

' ── Réseaux ──────────────────────────────────────────

cloud  "LAN Local\n(Wi-Fi entreprise)" as LAN

Desktop  --> Internet : HTTPS
Mobile   --> Internet : HTTPS (option 1)
Mobile   --> LAN      : HTTP/HTTPS (option 2)

' ── Serveur Backend ──────────────────────────────────

node "Serveur Backend\n(Ubuntu · JVM 21)" as BackendServer {
    component "Spring Boot 3.x\n(Port 8080)" as SpringBoot
    component "API REST\n(Spring MVC)"       as RestAPI
    SpringBoot --> RestAPI
}

Internet --> BackendServer : HTTPS
LAN      --> BackendServer : HTTP

' ── Serveur Base de données ──────────────────────────

node "Serveur BDD\n(Ubuntu · Port 3306)" as DBServer {
    database "MySQL 8.x" as MySQL
}

BackendServer --> DBServer : JDBC / JPA (HikariCP)
' ── Backup NAS ───────────────────────────────────────

node "NAS\n(Synology / TrueNAS)" as NAS {
    component "Stockage Backup\n(RAID)" as NASStorage
    component "Service Backup\n(rsync / SMB / NFS)" as NASService
}

cloud "Stockage Externe\n(Cloud)" as OffsiteBackup

' Backup base de données
DBServer --> NASService : Dump MySQL (scp / rsync)
NASService --> NASStorage : fichiers .sql

' Backup fichiers (PDF, images)
BackendServer --> NASService : rsync
NASService --> NASStorage : fichiers (.tar.gz)

' Sync externe
NASStorage --> OffsiteBackup : Sync (rclone / Cloud Sync)
@enduml